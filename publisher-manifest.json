px 0;border-top:1px dashed var(--line)}\n.plan li:first-child{border-top:none}\n.plan.recommend{background:var(--deep);color:var(--cream)}\n.plan.recommend h3,.plan.recommend .price{color:var(--cream)}\n.plan.recommend .annual{color:#cdb98a}\n.plan.recommend li{color:#ece1c4;border-top-color:rgba(217,154,58,.35)}\n.plan.recommend .ord{color:var(--amber);opacity:.9}\n.plan .tag{display:inline-block;font-family:\"Inter\",sans-serif;font-size:11px;letter-spacing:.22em;text-transform:uppercase;background:var(--amber);color:var(--deep);padding:3px 8px;border-radius:2px;margin-bottom:10px;position:relative;z-index:1}\n\n.qa-group{margin-bottom:34px}\n.qa-group h3{font-size:19px;color:var(--deep);margin:0 0 12px;padding-bottom:8px;border-bottom:1px solid var(--line);font-weight:600}\n.qa{border-top:1px solid var(--line);padding:16px 0}\n.qa:first-of-type{border-top:none}\n.qa summary{cursor:pointer;font-weight:600;color:var(--deep);font-size:16px;list-style:none;display:flex;gap:12px;align-items:flex-start}\n.qa summary::-webkit-details-marker{display:none}\n.qa summary::before{content:\"Q\";font-family:\"Inter\",sans-serif;background:var(--amber);color:var(--deep);width:24px;height:24px;display:inline-flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;flex-shrink:0}\n.qa summary::after{content:\"+\";margin-left:auto;color:var(--amber2);font-family:\"Inter\",sans-serif;font-size:22px;line-height:1}\n.qa[open] summary::after{content:\"−\"}\n.qa .answer{margin:14px 0 4px 36px;font-size:15px;color:var(--ink2)}\n\n.clinets{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:10px}\n.client{border:1px solid var(--line);padding:20px 22px;background:var(--paper)}\n.client h3{margin:0 0 6px;font-size:17px;color:var(--deep);font-weight:600}\n.client .meta{font-family:\"Inter\",sans-serif;font-size:12px;color:var(--muted);letter-spacing:.1em;margin-bottom:10px;text-transform:uppercase}\n.client p{margin:0;font-size:14.5px;color:var(--ink2)}\n\n.guide{display:grid;grid-template-columns:1fr 1fr;gap:32px;margin-top:10px}\n.guide .col h3{font-size:18px;color:var(--deep);margin:0 0 8px;font-weight:600}\n.guide .col p{margin:0 0 16px;font-size:15px;color:var(--ink2)}\n\nfooter{background:var(--deep);color:var(--cream);padding:46px 0 38px;margin-top:40px}\nfooter .ft-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:30px}\nfooter h4{font-family:\"Inter\",sans-serif;font-size:12px;letter-spacing:.24em;text-transform:uppercase;color:var(--amber);margin:0 0 12px}\nfooter p,footer a{font-size:13.5px;color:#e7d9b3;line-height:1.8}\nfooter a{border:none;color:var(--cream)}\nfooter a:hover{color:var(--amber)}\nfooter .copy{margin-top:30px;padding-top:18px;border-top:1px solid #2a3f5c;font-size:12px;color:#9aa6b5;font-family:\"Inter\",sans-serif}\n\n@media(max-width:780px){\n.hero h1{font-size:38px}\n.plans{grid-template-columns:1fr}\n.plan{border-right:none;border-bottom:1px solid var(--line)}\n.plan:last-child{border-bottom:none}\n.clinets,.guide,.ft-grid{grid-template-columns:1fr}\n.step{grid-template-columns:60px 1fr;gap:14px}\n.step .ord{font-size:42px}\n.plan .ord{font-size:64px}\n}\n</style><nav class=\"wrap\" aria-label=\"面包屑与目录\">\n<div class=\"crumbs\"><a href=\"#\">首页</a> / <span>兰溪谷</span> / <span>服务说明</span></div>\n<div class=\"toc\" role=\"navigation\">\n<a href=\"#start\" class=\"current\">开篇</a>\n<a href=\"#guide\">使用指南</a>\n<a href=\"#plans\">套餐对比</a>\n<a href=\"#clients\">客户端</a>\n<a href=\"#faq\">常见问题</a>\n<a href=\"#story\">写在后面</a>\n</div>\n</nav>\n\n<main>\n\n<header class=\"hero wrap\" id=\"start\">\n<div class=\"kicker\">编者按 · 服务说明</div>\n<h1>兰溪谷,把<em>一次连接</em>当作一篇文章来打磨</h1>\n<p class=\"lede\">做这个项目的人相信,稳定的网络体验不是参数表上的一行数字,而是日常写作、研究与阅读里无数次的顺畅。我们试着把兰溪谷的脉络写成一篇可以慢慢读下去的文字,顺便回答几个最常被问到的问题。</p>\n<div class=\"byline\">兰溪谷 · 编辑组 / 第 6052 期</div>\n<p class=\"body\">在接下来几节里,你将看到它如何被启动,如何选择适合自己的那一档,以及在客户端、设备数量与节点切换上常见的小疑问。我们尽量不使用夸张的修辞,把所有信息摊在桌面上,让它像一封写给朋友的说明信。</p>\n</header>\n\n<section class=\"block wrap\" id=\"guide\">\n<h2><span class=\"num\">壹 · 使用指南</span>从订阅到第一次连接,中间有几步</h2>\n<p class=\"sub\">按下面的顺序进行,大约只需要十来分钟。如果中途遇到疑问,翻到本页末尾的常见问题区,大多数情况都能找到对应说明。</p>\n<div class=\"steps\">\n<div class=\"step\">\n<div class=\"ord\">01</div>\n<div>\n<h3>挑选合适的一档,记下结算方式</h3>\n<p>兰溪谷目前提供基础版、旗舰版与团队版三档。差别主要在每月流量、设备上限以及是否包含专线与专属服务;若只是个人写作与浏览,基础版已经够用,需要长时间高质量线路再考虑升级。</p>\n</div>\n</div>\n<div class=\"step\">\n<div class=\"ord\">02</div>\n<div>\n<h3>在用户中心获取订阅链接</h3>\n<p>完成下单之后,登录兰溪谷用户中心即可看到一串以特定前缀开头的订阅地址。建议在安全的环境下复制,避免被无关软件误读;链接本身只对当前账号开放,请勿分享给他人。</p>\n</div>\n</div>\n<div class=\"step\">\n<div class=\"ord\">03</div>\n<div>\n<h3>在客户端粘贴订阅并刷新</h3>\n<p>在桌面或手机客户端的「订阅」一项中,把上一步得到的地址粘贴进去,等待几秒让节点列表同步。首次同步可能稍慢,后续每次点击「更新订阅」即可拉取最新节点。</p>\n</div>\n</div>\n<div class=\"step\">\n<div class=\"ord\">04</div>\n<div>\n<h3>按场景选择节点,开始使用</h3>\n<p>节点列表会按地区与类型分组。如果只是为了日常浏览,选择延迟较低的节点即可;若需要长时间观看视频或进行跨国资料传输,建议优先选择标注「IPLC」「专线」字样的节点。</p>\n</div>\n</div>\n</div>\n</section>\n\n<section class=\"block wrap\" id=\"plans\">\n<h2><span class=\"num\">贰 · 套餐对比</span>三档,从轻量到团队</h2>\n<p class=\"sub\">所有套餐都支持按月或按年结算,按年付的总价相当于十个月的费用。下方按阶梯排列,数字编号以背景大字的形式压在卡片右下角,方便在不同档位之间快速定位。</p>\n<div class=\"plans\">\n\n<article class=\"plan\">\n<span class=\"tag\">入门</span>\n<h3>基础版</h3>\n<div class=\"price\">¥15/月</div>\n<div class=\"annual\">按年付仅需 ¥150/年</div>\n<ul>\n<li>每月 100GB 极速流量</li>\n<li>支持 3 台设备同时在线</li>\n<li>解锁基础流媒体</li>\n<li>普通线路节点池</li>\n</ul>\n<div class=\"ord\">01</div>\n</article>\n\n<article class=\"plan recommend\">\n<span class=\"tag\">推荐</span>\n<h3>旗舰版</h3>\n<div class=\"price\">¥35/月</div>\n<div class=\"annual\">按年付仅需 ¥350/年</div>\n<ul>\n<li>每月 300GB 极速流量</li>\n<li>支持 5 台设备同时在线</li>\n<li>全节点原生流媒体解锁</li>\n<li>IPLC 专线游戏加速优化</li>\n<li>7x24 优先工单支持</li>\n</ul>\n<div class=\"ord\">02</div>\n</article>\n\n<article class=\"plan\">\n<span class=\"tag\">进阶</span>\n<h3>团队版</h3>\n<div class=\"price\">¥85/月</div>\n<div class=\"annual\">按年付仅需 ¥850/年</div>\n<ul>\n<li>每月 1000GB 极速流量</li>\n<li>支持 20 台设备同时在线</li>\n<li>VIP 专属高带宽节点</li>\n<li>支持企业定制路由</li>\n<li>专属客户经理服务</li>\n</ul>\n<div class=\"ord\">03</div>\n</article>\n\n</div>\n</section>\n\n<section class=\"block wrap\" id=\"clients\">\n<h2><span class=\"num\">叁 · 客户端</span>在不同设备上的常见形态</h2>\n<p class=\"sub\">兰溪谷的订阅地址是通用格式,理论上兼容多数遵循同一规范的应用。下列几类客户端在用户中较为常见,具体下载地址与版本以你所用平台的应用商店为准。</p>\n<div class=\"clinets\">\n<div class=\"client\">\n<h3>桌面端(Windows / macOS)</h3>\n<div class=\"meta\">WINDOWS 10+ · MACOS 11+</div>\n<p>桌面端在节点切换上更灵活,通常支持按程序分流和系统代理两种模式。如果工作里需要长时间挂着,推荐选择支持开机自启的版本,避免每次手动开启。</p>\n</div>\n<div class=\"client\">\n<h3>移动端(iOS / Android)</h3>\n<div class=\"meta\">IOS 14+ · ANDROID 8+</div>\n<p>移动端常以 VPN 配置或应用内代理的形式运行。首次安装时需要信任相应证书或允许 VPN 权限,完成后即可在状态栏看到连接图标,方便随时查看状态。</p>\n</div>\n<div class=\"client\">\n<h3>命令行 / 路由器</h3>\n<div class=\"meta\">OPENWRT · CLI</div>\n<p>熟悉命令行的用户可以将订阅地址转换成配置,用于路由器或自建脚本环境。这一类方式更适合团队版用户,把整个局域网交给代理节点统一调度。</p>\n</div>\n<div class=\"client\">\n<h3>浏览器扩展</h3>\n<div class=\"meta\">CHROME / EDGE / FIREFOX</div>\n<p>浏览器扩展通常作用于 HTTP 与 HTTPS 流量,适合只需要在浏览器里访问外部资料、不希望影响其他应用的情况。系统级操作仍然需要回到桌面端处理。</p>\n</div>\n</div>\n</section>\n\n<section class=\"block wrap\" id=\"faq\">\n<h2><span class=\"num\">肆 · 常见问题</span>按主题分组,按场景查找</h2>\n<p class=\"sub\">如果下面没有涵盖你的疑问,可在用户中心提交工单;旗舰版与团队版的工单会被优先处理。</p>\n\n<div class=\"qa-group\">\n<h3>订阅与付款</h3>\n<details class=\"qa\">\n<summary>兰溪谷是否提供免费试用?</summary>\n<p class=\"answer\">目前不开放长期免费试用,但在部分活动期会放出短期体验码,具体以官网公告为准。请勿相信第三方渠道分享的所谓「永久激活码」。</p>\n</details>\n<details class=\"qa\">\n<summary>按月付和按年付之间的差别在哪里?</summary>\n<p class=\"answer\">按年付的总价相当于十个月的费用,平均到每个月更划算一些;按月付灵活度更高,适合先体验再决定的用户。两者在功能与节点上没有差别。</p>\n</details>\n<details class=\"qa\">\n<summary>中途想升级或降级套餐,怎么处理?</summary>\n<p class=\"answer\">在用户中心提交变更申请即可。系统会根据剩余天数折算差价,降级时多出的部分会以余额的形式留在账号里,供后续使用。</p>\n</details>\n</div>\n\n<div class=\"qa-group\">\n<h3>设备与节点</h3>\n<details class=\"qa\">\n<summary>可以同时在多少台设备上使用?</summary>\n<p class=\"answer\">具体数量取决于所选套餐:基础版 3 台,旗舰版 5 台,团队版 20 台。这里的「设备」指的是同时在线的连接数,而非累计登录次数。</p>\n</details>\n<details class=\"qa\">\n<summary>节点列表里那些字母缩写代表什么?</summary>\n<p class=\"answer\">常见的有按地区划分的缩写(如 JP、SG、US),以及按线路类型标注的关键词(如「IPLC」「专线」「普通」)。同一地区的不同线路在稳定性与延迟上会有差别。</p>\n</details>\n<details class=\"qa\">\n<summary>为什么同一个节点在不同时间表现不同?</summary>\n<p class=\"answer\">跨境线路的延迟与带宽受多个因素影响,包括本地运营商、当下时段与目标服务器的负载。兰溪谷会持续记录这些数据并淘汰表现不佳的节点。</p>\n</details>\n</div>\n\n<div class=\"qa-group\">\n<h3>使用与排查</h3>\n<details class=\"qa\">\n<summary>连接上了却打不开网页,可能是什么原因?</summary>\n<p class=\"answer\">先确认系统时间是否准确,误差过大会导致 TLS 握手失败;其次检查客户端是否设置为全局代理,部分应用默认绕过了代理设置。</p>\n</details>\n<details class=\"qa\">\n<summary>流量是如何计算的?</summary>\n<p class=\"answer\">按实际通过代理节点的字节数计量,上行与下行都计入总量。客户端本地缓存、局域网内网通信与未被代理的流量不计入套餐流量。</p>\n</details>\n<details class=\"qa\">\n<summary>海外出差或回国期间使用,需要做什么?</summary>\n<p class=\"answer\">建议在出发前先在客户端里更新一次订阅,确认节点列表为最新版本;落地后若发现部分节点不可用,切换到延迟更低的地区即可,通常不需要调整订阅链接。</p>\n</details>\n</div>\n\n<div class=\"qa-group\">\n<h3>账户与隐私</h3>\n<details class=\"qa\">\n<summary>兰溪谷会保留访问日志吗?</summary>\n<p class=\"answer\">出于故障排查的需要,系统会短时间保留必要的连接元数据(如时间、节点、流量),但不会保留具体的访问内容记录,相关数据在到期后会按既定规则清除。</p>\n</details>\n<details class=\"qa\">\n<summary>忘记密码怎么办?</summary>\n<p class=\"answer\">在登录页点击「找回密码」,通过注册邮箱接收一次性重置链接即可。若邮箱也无法使用,需要联系人工客服并提供必要的身份验证信息。</p>\n</details>\n</div>\n</section>\n\n<section class=\"block wrap\" id=\"story\">\n<h2><span class=\"num\">伍 · 写在后面</span>给愿意读到这里的人</h2>\n<p class=\"sub\">兰溪谷并不是一个用来炫耀参数的项目。它更像一本愿意被反复翻阅的小册子,把每一次连接的细节摆在桌上,让使用它的人感到踏实。</p>\n<div class=\"guide\">\n<div class=\"col\">\n<h3>它适合谁?</h3>\n<p>适合那些把网络当作工具,而非玩具的人。写作者、研究者、跨境团队,以及所有在意连接是否稳定、按月付出是否值得的人,都可以在这里找到合适的位置。</p>\n<h3>它不适合谁?</h3>\n<p>如果你追求的是「永远不断」「速度第一」这类绝对承诺,代理服务并不是合适的答案。它更像一条需要共同维护的通路,我们负责线路,用户负责使用方式。</p>\n</div>\n<div class=\"col\">\n<h3>接下来该做什么?</h3>\n<p>如果还在犹豫,从基础版开始即可。一两周的时间足够判断它是否符合你的日常节奏;若是合拍,再考虑升级也不迟。我们会在用户中心保留所有升级选项,不会主动打扰。</p>\n<h3>遇到问题怎么联系?</h3>\n<p>所有套餐都可以在用户中心提交工单;旗舰版与团队版的工单会被标记为优先处理。我们尽量在 24 小时内给出首次回复,复杂问题会顺延并同步进展。</p>\n</div>\n</div>\n</section>\n\n</main>\n\n<footer>\n<div class=\"wrap ft-grid\">\n<div>\n<h4>关于兰溪谷</h4>\n<p>兰溪谷是一项围绕写作、研究与日常浏览场景打磨的代理服务,以稳定的连接、清晰的套餐说明与按主题分组的常见问题,代替空洞的宣传。</p>\n</div>\n<div>\n<h4>导航</h4>\n<p><a href=\"#start\">开篇</a><br>\n<a href=\"#guide\">使用指南</a><br>\n<a href=\"#plans\">套餐对比</a><br>\n<a href=\"#faq\">常见问题</a></p>\n</div>\n<div>\n<h4>说明</h4>\n<p>本页所示价格为示例性展示,实际以下单页面为准。<br>\n具体节点表现与当地网络环境相关,请以真实使用为准。</p>\n</div>\n</div>\n<div class=\"wrap copy\">© 兰溪谷 · 编辑组撰写的服务说明文档 · 仅作内容展示用途</div>\n</footer>",
